{
  "name": "fraud-detection-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dashboard React TypeScript pour le système PFA de détection de fraude",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
