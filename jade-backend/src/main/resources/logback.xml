<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ============================================
         Encoder JSON structuré (LogstashEncoder)
         pour ingestion par Loki/Elastic en prod.
         ============================================ -->
    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>true</includeContext>
            <includeMdc>true</includeMdc>
            <customFields>{"app":"jade-backend","module":"fraud-detection"}</customFields>
        </encoder>
    </appender>

    <!-- ============================================
         Encoder console "humain" pour le dev local.
         Activé via -Dlogback.profile=dev
         ============================================ -->
    <appender name="HUMAN_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{32} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="HUMAN_STDOUT"/>
    </root>

    <logger name="org.hibernate"        level="WARN"/>
    <logger name="com.zaxxer.hikari"    level="WARN"/>
    <logger name="org.glassfish.tyrus"  level="INFO"/>
    <logger name="org.glassfish.grizzly" level="WARN"/>
    <logger name="jade"                 level="INFO"/>
    <logger name="com.pfa.fraud"        level="INFO"/>
</configuration>
