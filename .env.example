# ============================================================
# Configuration PFA Fraud Detection
# Copier en .env et adapter avant `docker compose up`.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=fraud_detection
POSTGRES_USER=pfa_user
POSTGRES_PASSWORD=changeme

# --- ML API ---
ML_API_URL=http://ml-api:5000

# --- JADE backend ---
JADE_GUI=false
LOG_LEVEL=INFO

# --- Simulateur ---
# Nombre de transactions générées par seconde (peut être décimal, ex. 0.5)
SIM_RATE=2
# Taux de fraude injecté (0.05 = 5%)
SIM_FRAUD_RATE=0.05

# --- Frontend ---
# URL WebSocket exposée au navigateur du client (pas au container).
# En local : ws://localhost:8080/alertes
VITE_WS_URL=ws://localhost:8080/alertes
